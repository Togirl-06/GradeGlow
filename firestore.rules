rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function planUnchanged() {
      return !('plan' in request.resource.data)
        || request.resource.data.plan == resource.data.plan
        || request.resource.data.plan == 'free';
    }

    // Profile + personal subcollections. Clients cannot self-upgrade to paid plans.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && (!('plan' in request.resource.data)
            || request.resource.data.plan == 'free');
      allow update: if isOwner(userId) && planUnchanged();
      allow delete: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Shared course catalog — owner-scoped writes
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    // Community questions — author-owned edits/deletes
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAny(['authorId', 'uploaderId', 'createdBy']);
      allow update, delete: if isSignedIn()
        && (resource.data.authorId == request.auth.uid
            || resource.data.uploaderId == request.auth.uid
            || resource.data.createdBy == request.auth.uid);
    }

    // Uploaded study materials — uploader-owned
    match /materials/{materialId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uploaderId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.uploaderId == request.auth.uid;
    }

    // Posted solutions + per-user votes
    match /solutions/{solutionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.authorId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.authorId == request.auth.uid;

      match /votes/{voteId} {
        allow read, write, delete: if isSignedIn() && voteId == request.auth.uid;
      }
    }
  }
}

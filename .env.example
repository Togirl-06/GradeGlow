# Firebase is configured in lib/firebase_options.dart (from FlutterFire CLI).

# Prefer compile-time define (never commit real keys):
#   flutter run --dart-define=OPENAI_API_KEY=sk-...
# Web production: enable Firebase Blaze and deploy functions so /api/openai proxies OpenAI.
OPENAI_API_KEY=

# Optional: override proxy base (defaults to same-origin /api/openai on web when no client key)
# OPENAI_PROXY_URL=https://gradeglow-virtualuni.web.app/api/openai

# Stripe (server-side only — copied into functions/.env by scripts/deploy_web.ps1)
# Dashboard → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Firebase Auth > Google > Web client ID
GOOGLE_WEB_CLIENT_ID=

# Package ID is com.gradeglow.app — register that app in Firebase, then
# re-download google-services.json / GoogleService-Info.plist.
# Android Google Sign-In SHA-1: .\scripts\get_sha1.ps1

# Firebase is configured in lib/firebase_options.dart (from FlutterFire CLI).
# Do NOT duplicate Firebase keys here unless you prefer .env override.

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Firebase Auth > Sign-in method > Google > Web client ID (ends with .apps.googleusercontent.com)
GOOGLE_WEB_CLIENT_ID=

# Android Google Sign-In also requires SHA-1 in Firebase. Run: .\scripts\get_sha1.ps1
# Then download a new android/app/google-services.json (oauth_client must not be empty).
